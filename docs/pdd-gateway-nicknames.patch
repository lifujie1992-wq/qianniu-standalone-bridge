+def _taobao_nickname(value, buyer_id: str = "") -> str:
+    if not isinstance(value, str):
+        return ""
+    nick = value.strip()
+    if not nick or len(nick) > 128 or any(ord(c) < 32 for c in nick):
+        return ""
+    if nick == buyer_id or re.fullmatch(r"\d+(?:\.\d+)?(?:-\d+(?:\.\d+)?)?(?:#\d+)?", nick):
+        return ""
+    if "#" in nick and "@" in nick:
+        return ""
+    return nick
+
