+def test_enqueue_failure_releases_claim_for_retry(tmp_path, monkeypatch):
+    from pdd_brain.tmall_conversation import enqueue_history_resume
+
+    app, store = install_store(tmp_path, monkeypatch)
+    now = int(time.time())
+    for mid, role, text, ts in [
+        ("n", "user", "由 服务助手 转交给 燕燕", now),
+        ("q", "user", "物联卡是什么", now - 5),
+        ("ack", "assistant_simulated", "已接到您的咨询", now + 1),
+    ]:
+        row = app.ChatMessage(
+            msg_id=mid,
+            account=ACCOUNT,
+            buyer_id="buyer",
+            role=role,
+            content=text,
+            ts=ts,
+        )
+        if mid == "ack":
+            row.parent_msg_id = "n"
+            row.shadow_status = "succeeded"
+            row.whitebox = {
+                "tmall_reply_quality": {"reason": "transfer_first_response"}
+            }
+        store.ingest(row)
+    monkeypatch.setitem(app.CONFIG, "shadow_enabled", True)
+    monkeypatch.setattr(
+        app.SHADOW_WORKER,
+        "enqueue",
+        lambda *a, **kw: {"ok": False, "status": "queue_unavailable"},
+    )
+    assert enqueue_history_resume(ACCOUNT, "buyer")["enqueue"]["ok"] is False
+    assert not store.find_message(ACCOUNT, "buyer", "n").whitebox.get(
+        "tmall_context_resume"
+    )
+    monkeypatch.setattr(
+        app.SHADOW_WORKER, "enqueue", lambda *a, **kw: {"ok": True, "status": "queued"}
+    )
+    assert enqueue_history_resume(ACCOUNT, "buyer")["enqueue"]["status"] == "queued"
+
+
