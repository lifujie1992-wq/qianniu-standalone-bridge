diff --git a/pdd_brain/tmall_conversation.py b/pdd_brain/tmall_conversation.py
new file mode 100644
--- /dev/null
+++ b/pdd_brain/tmall_conversation.py
@@ -0,0 +1,294 @@
+"""Server-owned projection of raw Tmall events; persisted records remain unchanged."""
+
+from __future__ import annotations
+import re
+import math
+from collections.abc import Mapping
+from typing import Any
+
+FEATURE = "tmall_conversation_extraction_v1"
+
+
+def get(row: Any, key: str, default: Any = "") -> Any:
+    return (
+        row.get(key, default)
+        if isinstance(row, Mapping)
+        else getattr(row, key, default)
+    )
+
+
+def in_scope(account: str, platform: str = "taobao") -> bool:
+    return (
+        platform == "taobao"
+        and re.split(r"[:：]", str(account or "").removeprefix("tb_nick_"), maxsplit=1)[
+            0
+        ]
+        == "联想官方旗舰店"
+    )
+
+
+def raw_event(item: dict) -> dict:
+    """Allowlisted evidence, never credentials or an entire SDK/window dump."""
+    keys = (
+        "platform",
+        "account",
+        "buyer_id",
+        "content",
+        "original_msg_id",
+        "original_timestamp",
+        "ts",
+        "capture_mode",
+        "source",
+        "raw_type",
+        "incomplete",
+        "identity_uncertain",
+        "sender_uid",
+        "recipient_uid",
+        "login_uid",
+        "sender_nick",
+        "recipient_nick",
+        "staff_name",
+    )
+    result = {
+        k: item[k]
+        for k in keys
+        if k in item and isinstance(item[k], (str, int, float, bool))
+    }
+    result["reported_role"] = str(item.get("role") or "")
+    return result
+
+
+def sender_role(row: Any) -> tuple[str, str]:
+    """Concrete sender evidence wins over textual heuristics; empty = legacy fallback."""
+    account = str(get(row, "account"))
+    if not in_scope(account):
+        return "", ""
+    box = get(row, "whitebox", {}) or {}
+    raw = box.get("tmall_raw_event") or {}
+    if not isinstance(raw, dict) or not in_scope(
+        str(raw.get("account")), str(raw.get("platform"))
+    ):
+        return "", ""
+    if str(raw.get("account")) != account or str(raw.get("buyer_id")) != str(
+        get(row, "buyer_id")
+    ):
+        return "", ""
+
+    def uid(value):
+        value = str(value or "")
+        return value.split(".")[0] if re.fullmatch(r"\d+(?:\.\d+)?", value) else ""
+
+    sender = uid(raw.get("sender_uid"))
+    login = uid(raw.get("login_uid"))
+    buyer = re.match(r"^(\d+)\.", str(get(row, "buyer_id")))
+    nick = str(raw.get("sender_nick") or raw.get("staff_name") or "")
+    if (
+        (sender and login and sender == login)
+        or (":" in nick or "：" in nick)
+        and re.split(r"[:：]", nick, maxsplit=1)[0] == "联想官方旗舰店"
+    ):
+        return "mall_cs", "sender_identity"
+    if sender and buyer and sender == buyer.group(1):
+        return "user", "sender_identity"
+    if raw.get("identity_uncertain") or raw.get("reported_role") in {
+        "system",
+        "unknown",
+    }:
+        return "system", "identity_unresolved"
+    return "", ""
+
+
+def timestamp(row: Any) -> float:
+    box = get(row, "whitebox", {}) or {}
+    raw = box.get("tmall_raw_event") or {}
+    try:
+        value = float(raw.get("original_timestamp") or get(row, "ts") or 0)
+        if not math.isfinite(value) or value <= 0:
+            return 0
+        while value > 1e11:
+            value /= 1000
+        return value
+    except (TypeError, ValueError, AttributeError):
+        return 0
+
+
+def ordered_messages(messages: list[Any]) -> list[Any]:
+    """Sort a detached view only; missing timestamps keep the original order."""
+    if any(timestamp(row) <= 0 for row in messages):
+        return list(messages)
+    return sorted(messages, key=timestamp)
+
+
+def extraction_trace(messages: list[Any], target: Any) -> dict:
+    from .tmall_reply_quality import context_role
+
+    return {
+        "feature": FEATURE,
+        "target_msg_id": get(target, "msg_id"),
+        "order": "original_message_time",
+        "events": [
+            {
+                "msg_id": get(row, "msg_id"),
+                "role": context_role(row),
+                "identity_source": sender_role(row)[1] or "legacy_identity_or_template",
+                "original_timestamp": timestamp(row),
+            }
+            for row in messages
+        ][-100:],
+    }
+
+
+def claim_history_resume(session: Any, now: float, max_age: float = 120) -> dict:
+    """One continuation of a first-response-only transfer, never a historical replay."""
+    if (
+        not session
+        or not in_scope(get(session, "account"))
+        or get(session, "ai_takeover_override", None) is False
+        or str(get(session, "handoff_reason")).startswith("manual")
+    ):
+        return {}
+    from .taobao_transfer import is_taobao_transfer_notice
+    from .tmall_reply_quality import context_role, pending_transfer_question
+
+    rows = ordered_messages(list(get(session, "messages", []) or []))
+    for i in range(len(rows) - 1, -1, -1):
+        notice = rows[i]
+        if not is_taobao_transfer_notice(get(notice, "content")):
+            continue
+        if not 0 <= now - timestamp(notice) <= max_age:
+            return {}
+        nid = get(notice, "msg_id")
+        receipt_texts = {
+            re.sub(r"[\s~～。]+", "", str(get(r, "content")))
+            for r in rows
+            if get(r, "role") == "assistant_simulated"
+            and get(r, "parent_msg_id") == nid
+            and ((get(r, "whitebox", {}) or {}).get("tmall_reply_quality") or {}).get(
+                "reason"
+            )
+            == "transfer_first_response"
+        }
+        after = rows[i + 1 :]
+        # A newer buyer turn or a genuine staff reply owns the next action.
+        for row in after:
+            role = context_role(row)
+            if role == "user":
+                return {}
+            if (
+                role == "mall_cs"
+                and re.sub(r"[\s~～。]+", "", str(get(row, "content")))
+                not in receipt_texts
+                and get(row, "source") != "self-send"
+                and not str(get(row, "msg_id")).startswith("self-brain-")
+            ):
+                return {}
+        receipts = []
+        for row in rows:
+            if (
+                get(row, "role") != "assistant_simulated"
+                or get(row, "parent_msg_id") != nid
+            ):
+                continue
+            box = get(row, "whitebox", {}) or {}
+            if (box.get("tmall_reply_quality") or {}).get(
+                "reason"
+            ) == "transfer_first_response":
+                receipts.append(row)
+            elif get(row, "shadow_status") == "succeeded":
+                return {}
+        if not receipts:
+            return {}
+        pending = pending_transfer_question(rows[:i], notice)
+        if not pending:
+            return {}
+        box = dict(get(notice, "whitebox", {}) or {})
+        key = str(pending["msg_id"])
+        if (box.get("tmall_context_resume") or {}).get("question_msg_id") == key:
+            return {}
+        box["tmall_context_resume"] = {
+            "feature": FEATURE,
+            "question_msg_id": key,
+            "claimed_at": now,
+        }
+        notice.whitebox = box
+        return {"parent_msg_id": nid, "question_msg_id": key}
+    return {}
+
+
+def enqueue_history_resume(account: str, buyer_id: str) -> dict:
+    if not in_scope(account):
+        return {}
+    import time
+    from .runtime import runtime
+
+    if not runtime.CONFIG.get("shadow_enabled"):
+        return {}
+    with runtime.STATE_LOCK:
+        session = runtime.STORE.sessions.get(runtime.STORE.key(account, buyer_id))
+        plan = claim_history_resume(
+            session,
+            time.time(),
+            float(runtime.CONFIG.get("shadow_live_message_max_age_seconds") or 120),
+        )
+        if not plan:
+            return {}
+        runtime.STORE.mark_session_dirty(account, buyer_id)
+    key = runtime.STORE.key(account, buyer_id)
+    runtime.STORE.save(dirty_only=True, session_keys={key}, concurrent=True)
+    try:
+        result = runtime.SHADOW_WORKER.enqueue(
+            account,
+            buyer_id,
+            plan["parent_msg_id"],
+            force=True,
+            regeneration_source="system_context_refresh",
+        )
+    except Exception as exc:
+        result = {"ok": False, "status": "enqueue_failed", "error": type(exc).__name__}
+    if isinstance(result, dict) and (
+        result.get("ok") is False or result.get("status") == "already_queued"
+    ):
+        with runtime.STATE_LOCK:
+            notice = runtime.STORE.find_message(
+                account, buyer_id, plan["parent_msg_id"]
+            )
+            if notice:
+                notice.whitebox.pop("tmall_context_resume", None)
+                runtime.STORE.mark_session_dirty(account, buyer_id)
+        runtime.STORE.save(dirty_only=True, session_keys={key}, concurrent=True)
+    return {**plan, "enqueue": result}
+
+
+def retain_literal_chat(row: Any) -> bool:
+    """Trusted raw records remain available; protocol frames still fail closed."""
+    box = get(row, "whitebox", {}) or {}
+    raw = box.get("tmall_raw_event") or {}
+    if not in_scope(get(row, "account")) or not in_scope(
+        raw.get("account"), raw.get("platform")
+    ):
+        return False
+    original_id = str(raw.get("original_msg_id") or "")
+    stored_id = str(get(row, "msg_id")).removeprefix("qn-msg-v1|taobao|")
+    mode = str(raw.get("capture_mode") or "")
+    source = str(raw.get("source") or "")
+    trusted = (
+        source == "qianniu_standalone_browser"
+        and mode.startswith(("event:", "event-local-db:", "poll:", "history_snapshot"))
+    ) or (
+        source == "qianniu_appbiz_on_message_arrive"
+        and mode == "appbiz_native_callback"
+    )
+    text = str(get(row, "content")).strip()
+    literal = (
+        text.lower() in {"hi", "ok"}
+        or re.fullmatch(r"\d{3,30}", text)
+        or re.fullmatch(r"https?://\S+", text)
+    )
+    return bool(
+        trusted
+        and literal
+        and "#" in str(get(row, "buyer_id"))
+        and "@" in str(get(row, "buyer_id"))
+        and re.fullmatch(r"\d{10,20}\.PNM", original_id)
+        and original_id == stored_id
+    )
