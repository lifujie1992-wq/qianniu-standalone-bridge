+from pdd_brain.tmall_conversation import raw_event
+
+
+def test_entry_payload_survives_without_flattening_or_mutation():
+    original = {'platform':'taobao','account':'联想官方旗舰店:燕燕','role':'system',
+                'buyer_id':'buyer','raw_message':{'entryContext':{'orderId':'1234567890123456789','product':{'sku':'套餐A'}}}}
+    captured=raw_event(original)
+    assert captured['raw_message']==original['raw_message']
+    captured['raw_message']['entryContext']['product']['sku']='changed'
+    assert original['raw_message']['entryContext']['product']['sku']=='套餐A'
+
+
+def test_other_platform_and_shop_do_not_gain_new_evidence_policy():
+    for platform,account in [('pdd','联想官方旗舰店'),('taobao','其他店')]:
+        assert 'raw_message' not in raw_event({'platform':platform,'account':account,'raw_message':{'entryContext':{}}})
